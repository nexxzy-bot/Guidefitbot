<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- targetSdk 35 включает edge-to-edge принудительно — временно отключаем,
         чтобы WebView не уезжал под системные бары (ruStore-обёртка) -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F2F7FC</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F2F7FC</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
