<?xml version="1.0" encoding="utf-8"?>
<!-- Только HTTPS: cleartext-трафик запрещён (безопасность, 152-ФЗ) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
