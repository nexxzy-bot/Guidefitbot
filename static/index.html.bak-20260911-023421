<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#F2F7FC">
<title>GuideFit</title>
<link rel="manifest" href="/manifest.webmanifest">
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
--bg:#F2F7FC;--bg2:#E7F0F9;--surface:#FFFFFF;--surface2:#F6FAFE;--solid:#EDF4FB;
--border:#E1EBF5;--border2:#D3E2F0;
--text:#0C2233;--text2:#4A617A;--text3:#8AA0B4;
--accent:#0D9BE8;--accent-dark:#0A7FC4;--accent-dim:#E1F2FC;--accent-text:#FFFFFF;
--amber:#F59E0B;--amber-dim:#FEF3DF;--cyan:#06B6D4;--cyan-dim:#DFF7FB;
--blue:#06B6D4;--blue-dim:#DFF7FB;
--green:#10B981;--green-dim:#DFF7EC;--red:#EF4444;--red-dim:#FDE8E8;
--violet:#7C6FF0;--violet-dim:#ECEAFF;
--r-sm:12px;--r:22px;--r-lg:24px;--r-xl:28px;
--sh:0 12px 32px rgba(12,60,100,.08);--sh-sm:0 4px 14px rgba(12,60,100,.06);--shadow:var(--sh)}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{font-family:'Manrope',-apple-system,sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
button{font-family:inherit;cursor:pointer}
input,select{font-family:inherit}
img{max-width:100%}
.app{max-width:480px;margin:0 auto;position:relative;min-height:100vh}
.screen{display:none;padding:14px 16px 112px;animation:fadeUp .25s ease}
.screen.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
h1{font-family:'Bebas Neue';font-size:38px;font-weight:400;line-height:1.02;letter-spacing:.015em}
h2{font-family:'Bebas Neue';font-size:27px;font-weight:400;letter-spacing:.015em}
h3{font-family:'Bebas Neue';font-size:18px;font-weight:400;letter-spacing:.03em}
.flex{display:flex}.gap{gap:8px}.gap2{gap:10px}.between{justify-content:space-between}.items-center{align-items:center}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.mb1{margin-bottom:6px}.mb2{margin-bottom:10px}.mb3{margin-bottom:16px}.mb4{margin-bottom:20px}
.mt2{margin-top:10px}.mt3{margin-top:16px}.mt4{margin-top:22px}
.text-center{text-align:center}
.subtle{color:var(--text3);font-size:12px;font-weight:600}
.muted{color:var(--text2)}
.small{font-size:12px}
.hidden{display:none!important}
.pressable{transition:transform .12s ease}
.pressable:active{transform:scale(.97)}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:18px;margin-bottom:12px;box-shadow:var(--sh-sm)}
.badge{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;border-radius:9px;font-size:10.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
.badge-accent{background:var(--accent-dim);color:var(--accent-dark)}
.badge-blue{background:var(--cyan-dim);color:#0891B2}
.badge-amber{background:var(--amber-dim);color:var(--amber)}
.badge-green{background:var(--green-dim);color:var(--green)}
.badge-violet{background:var(--violet-dim);color:var(--violet)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:none;border-radius:16px;padding:15px 18px;font-size:14.5px;font-weight:700;transition:transform .12s ease,opacity .15s ease}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--accent);color:#fff;box-shadow:0 8px 20px rgba(13,155,232,.35)}
.btn-ghost{background:var(--solid);color:var(--text)}
.btn-danger{background:var(--red-dim);color:var(--red)}
.btn-success{background:var(--green-dim);color:var(--green)}
.btn-block{width:100%}
.input-wrap{margin-bottom:14px}
.input-label{display:block;font-size:11.5px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--text3);margin-bottom:7px}
.input{width:100%;background:var(--surface);border:1.5px solid var(--border);border-radius:15px;padding:14px;font-size:15px;font-weight:600;color:var(--text);outline:none;transition:border-color .15s ease}
.input:focus{border-color:var(--accent)}
select.input{appearance:none}
.sel-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(0,1fr));gap:9px}
.sel-btn{display:flex;flex-direction:column;align-items:center;gap:6px;background:var(--surface);border:1.5px solid var(--border);border-radius:18px;padding:15px 8px;font-size:12.5px;font-weight:700;color:var(--text2);transition:all .15s ease}
.sel-btn .ic{display:flex}
.sel-btn .tx{color:var(--text)}
.sel-btn .sb{font-size:10.5px;font-weight:700;color:var(--text3)}
.sel-btn.active{border-color:var(--accent);background:var(--accent-dim);color:var(--accent-dark)}
.sel-btn.active .tx,.sel-btn.active .sb{color:var(--accent-dark)}
.icon-btn{width:42px;height:42px;border-radius:50%;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--text2);flex-shrink:0;box-shadow:var(--sh-sm)}
.hero-card{background:linear-gradient(135deg,#17A9F0 0%,#0D9BE8 45%,#0768B4 100%);border-radius:26px;padding:22px;margin-bottom:12px;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:14px;box-shadow:0 16px 36px rgba(13,140,220,.38)}
.hero-label{font-size:10.5px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;opacity:.8;margin-bottom:6px}
.hero-num{font-family:'Bebas Neue';font-size:38px;font-weight:400;line-height:.95}
.ring{position:relative;width:92px;height:92px;flex-shrink:0}
.ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.ring .bg{fill:none;stroke:rgba(255,255,255,.25);stroke-width:8}
.ring .fg{fill:none;stroke:#fff;stroke-width:8;stroke-linecap:round;transition:stroke-dashoffset .6s ease}
.ring span{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue';font-size:19px}
.hero-stats{display:flex;gap:8px;margin-top:16px}
.hero-stat{flex:1;background:rgba(255,255,255,.16);border-radius:15px;padding:10px 12px}
.hero-stat .v{font-family:'Bebas Neue';font-size:21px}
.hero-stat .l{font-size:9.5px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;opacity:.8;margin-top:2px}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.stat-pill{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px;display:flex;align-items:center;gap:12px;box-shadow:var(--sh-sm)}
.stat-ic{width:44px;height:44px;border-radius:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.stat-val{font-family:'Bebas Neue';font-size:23px;line-height:1}
.stat-lbl{font-size:10.5px;font-weight:700;color:var(--text3);margin-top:2px}
.stat-box{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px;text-align:center;box-shadow:var(--sh-sm)}
.stat-box .v{font-family:'Bebas Neue';font-size:23px}
.stat-box .l{font-size:10.5px;font-weight:700;color:var(--text3);margin-top:3px}
.kpi{background:var(--solid);border-radius:16px;padding:12px 6px;display:flex;margin:14px 0 4px}
.kpi .c{flex:1;display:flex;flex-direction:column;align-items:center;gap:1px}
.kpi .v{font-family:'Bebas Neue';font-size:21px}
.kpi .l{font-size:9.5px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--text3)}
.track{background:var(--solid);border-radius:99px;height:8px;overflow:hidden}
.fill{height:100%;border-radius:99px;transition:width .5s ease}
.fill-primary,.fill-accent{background:var(--accent)}
.fill-warn,.fill-amber{background:var(--amber)}
.fill-violet{background:var(--violet)}
.fill-blue{background:var(--cyan)}
.fill-green{background:var(--green)}
.fill-red{background:var(--red)}
.bar-chart{display:flex;align-items:flex-end;gap:6px;height:140px;padding:16px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r);margin-bottom:12px;box-shadow:var(--sh-sm)}
.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end}
.bar-track{flex:1;width:100%;max-width:26px;display:flex;align-items:flex-end;background:var(--solid);border-radius:8px;overflow:hidden}
.bar-in{width:100%;border-radius:8px;background:var(--accent);min-height:4px;transition:height .4s ease}
.bar-col.active .bar-in{background:var(--amber)}
.pct{font-family:'Bebas Neue';font-size:11px;color:var(--text3)}
.dl{font-size:10px;font-weight:800;color:var(--text3);text-transform:uppercase}
.day-card{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:15px;margin-bottom:10px;cursor:pointer;box-shadow:var(--sh-sm)}
.day-card.active{border-color:var(--accent);background:var(--accent-dim)}
.exercise-row{display:flex;justify-content:space-between;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:13px 14px;margin-bottom:8px}
.loc-card{background:var(--surface);border:1.5px solid var(--border);border-radius:20px;padding:16px 12px;display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;box-shadow:var(--sh-sm)}
.loc-card .ic{display:flex}
.loc-card svg{width:30px;height:30px;stroke:var(--accent)}
.loc-card span{font-weight:800;font-size:14px}
.loc-card .subtle{font-size:11.5px}
.loc-card.active{border-color:var(--accent);background:var(--accent-dim)}
.meal-item{display:flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:11px 12px;margin-bottom:9px;box-shadow:var(--sh-sm)}
.meal-thumb{width:48px;height:48px;border-radius:16px;background:var(--accent-dim);color:var(--accent);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden}
.meal-thumb img{width:100%;height:100%;object-fit:cover;border-radius:16px}
.meal-info{flex:1;min-width:0}
.meal-title{font-weight:800;font-size:13.5px}
.meal-cal{font-size:11.5px;color:var(--text3);font-weight:600}
.meal-add{width:36px;height:36px;border-radius:50%;background:var(--accent);color:#fff;border:none;font-size:21px;font-weight:500;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 6px 14px rgba(13,155,232,.35)}
.recipe-hero{width:100%;height:190px;border-radius:18px;object-fit:cover;margin-bottom:14px;background:var(--solid);display:flex;align-items:center;justify-content:center;color:var(--text3)}
.recipe-hero img{width:100%;height:100%;object-fit:cover;border-radius:18px}
.ex-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:13px 14px;margin-bottom:8px;box-shadow:var(--sh-sm)}
.stepper-btn{width:46px;height:46px;border-radius:14px;border:1.5px solid var(--border);background:var(--surface);font-size:20px;font-weight:700;color:var(--text)}
.set-row{display:flex;align-items:center;gap:11px;background:var(--solid);border-radius:14px;padding:9px 11px;margin-bottom:8px}
.set-row input{width:72px;background:var(--surface);border:1.5px solid var(--border);border-radius:11px;padding:10px 6px;font-size:14px;font-weight:700;color:var(--text);outline:none;text-align:center}
.set-row input:focus{border-color:var(--accent)}
.set-check{width:32px;height:32px;border-radius:50%;border:2px solid var(--border);background:var(--surface);flex-shrink:0;margin-left:auto}
.set-check.done{background:var(--green);border-color:var(--green);color:#fff}
.set-check.done svg{display:block}
.set-check svg{display:none;margin:6px}
.timer-big{font-family:'Bebas Neue';font-size:58px;text-align:center;color:var(--text);letter-spacing:.03em}
.rest-overlay{position:fixed;inset:0;background:rgba(242,247,252,.96);backdrop-filter:blur(8px);display:none;flex-direction:column;align-items:center;justify-content:center;gap:22px;z-index:60;padding:24px}
.rest-overlay.show{display:flex}
.rest-circle{width:160px;height:160px;border-radius:50%;border:7px solid var(--accent-dim);display:flex;align-items:center;justify-content:center;background:var(--surface);box-shadow:var(--sh)}
.rest-circle .t{font-family:'Bebas Neue';font-size:58px;color:var(--accent)}
.chip{padding:9px 15px;border-radius:99px;background:var(--surface);border:1px solid var(--border);font-size:12.5px;font-weight:700;color:var(--text2)}
.chip.active{background:var(--accent);border-color:var(--accent);color:#fff}
.segmented{display:flex;background:var(--solid);border-radius:14px;padding:4px;gap:4px}
.pill{display:flex;flex-direction:column;align-items:center;gap:3px;padding:7px 0;border-radius:14px;color:var(--text3);font-size:10px;font-weight:800;flex:1;transition:all .15s ease}
.pill svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.nav-item.active .pill{background:var(--accent);color:#fff;box-shadow:0 6px 14px rgba(13,155,232,.4)}
.bottom-nav{position:fixed;bottom:14px;left:50%;transform:translateX(-50%);width:min(440px,calc(100% - 28px));background:var(--surface);border:1px solid var(--border);border-radius:24px;display:flex;padding:7px;gap:4px;box-shadow:0 14px 36px rgba(12,60,100,.16);z-index:50}
.bottom-nav>button{flex:1;background:none;border:none;padding:0}
.toast{position:fixed;bottom:96px;left:50%;transform:translateX(-50%) translateY(18px);background:var(--text);color:#fff;padding:13px 18px;border-radius:14px;font-size:13.5px;font-weight:700;opacity:0;transition:all .25s ease;z-index:70;max-width:88%;text-align:center;box-shadow:0 10px 30px rgba(12,34,51,.3)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.toast.err{background:var(--red)}
.toast.ok{background:var(--green)}
.tooltip{position:relative;background:var(--cyan-dim);border:1px solid rgba(6,182,212,.2);color:var(--text);border-radius:18px;padding:13px 14px;font-size:13px;font-weight:600;margin-bottom:14px;display:flex;gap:10px;align-items:center}
.tooltip b{color:#0891B2}
.avatar{width:46px;height:46px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;overflow:hidden;flex-shrink:0}
.avatar img{width:100%;height:100%;object-fit:cover}
.home-head{display:flex;align-items:center;gap:12px;padding:10px 0 16px}
.ach{display:flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:12px;margin-bottom:8px;box-shadow:var(--sh-sm)}
.ach.locked{opacity:.45}
.ach-ic{width:46px;height:46px;border-radius:15px;background:var(--amber-dim);display:flex;align-items:center;justify-content:center;font-size:21px;flex-shrink:0}
.empty{text-align:center;padding:34px 18px;color:var(--text3);font-size:13px;font-weight:600}
.shimmer{background:linear-gradient(90deg,var(--solid) 25%,#E2EDF8 50%,var(--solid) 75%);background-size:200% 100%;animation:sh 1.3s infinite;border-radius:14px;height:64px;margin-bottom:10px}
@keyframes sh{to{background-position:-200% 0}}
.step{display:flex;align-items:center;gap:9px;font-size:13px;font-weight:700;color:var(--text2);margin-bottom:10px}
.step-n{width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11.5px;font-weight:800;flex-shrink:0}
</style>
</head>
<body>
<div class="app">
<div class="toast" id="toast"></div>
<div class="rest-overlay" id="restOverlay">
  <p class="subtle" style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.1em">Отдых между подходами</p>
  <div class="rest-circle"><div class="t" id="restTime">60</div></div>
  <button class="btn btn-primary" onclick="skipRest()">Пропустить</button>
</div>

<!-- ОНБОРДИНГ -->
<div class="screen active" id="screen-register">
  <div style="padding-top:36px">
    <div class="badge badge-accent mb2">GuideFit</div>
    <h1 style="margin-bottom:6px">Расскажи<br>о себе</h1>
    <p class="muted" style="font-size:14px;margin:10px 0 24px;line-height:1.55">Рассчитаем калории, БЖУ и подберём программу под твою цель</p>
    <form id="registerForm">
      <div class="input-wrap"><label class="input-label">Как тебя зовут?</label><input type="text" class="input" id="regName" required maxlength="30"></div>
      <div class="input-wrap"><label class="input-label">Пол</label>
        <div class="sel-row">
          <button type="button" class="sel-btn" id="btnMale" onclick="setGender('male')"><span class="ic" style="color:var(--accent)"><span data-ic="male" data-sz="22"></span></span><span class="tx">Мужчина</span></button>
          <button type="button" class="sel-btn" id="btnFemale" onclick="setGender('female')"><span class="ic" style="color:var(--accent)"><span data-ic="female" data-sz="22"></span></span><span class="tx">Женщина</span></button>
        </div><input type="hidden" id="regGender" required>
      </div>
      <div class="grid2">
        <div class="input-wrap"><label class="input-label">Возраст</label><input type="number" class="input" id="regAge" min="10" max="100" required></div>
        <div class="input-wrap"><label class="input-label">Рост, см</label><input type="number" class="input" id="regHeight" min="100" max="250" required></div>
      </div>
      <div class="grid2">
        <div class="input-wrap"><label class="input-label">Текущий вес</label><input type="number" step="0.1" class="input" id="regWeight" min="30" max="250" required></div>
        <div class="input-wrap"><label class="input-label">Целевой вес</label><input type="number" step="0.1" class="input" id="regTarget" min="30" max="250" required></div>
      </div>
      <div class="input-wrap"><label class="input-label">Цель</label>
        <div class="sel-row">
          <button type="button" class="sel-btn" id="btnLose" onclick="setGoal('lose')"><span class="ic" style="color:var(--accent)"><span data-ic="flame" data-sz="22"></span></span><span class="tx">Похудеть</span><span class="sb">−500 ккал</span></button>
          <button type="button" class="sel-btn" id="btnGain" onclick="setGoal('gain')"><span class="ic" style="color:var(--accent)"><span data-ic="dumbbell" data-sz="22"></span></span><span class="tx">Набрать</span><span class="sb">+500 ккал</span></button>
          <button type="button" class="sel-btn" id="btnMaintain" onclick="setGoal('maintain')"><span class="ic" style="color:var(--accent)"><span data-ic="zap" data-sz="22"></span></span><span class="tx">Поддержать</span><span class="sb">Баланс</span></button>
        </div><input type="hidden" id="regGoal" required>
      </div>
      <div class="input-wrap"><label class="input-label">Активность</label>
        <div class="sel-row">
          <button type="button" class="sel-btn" id="btnSedentary" onclick="setActivity('sedentary')"><span class="ic" style="color:var(--accent)"><span data-ic="chair" data-sz="22"></span></span><span class="tx">Малая</span><span class="sb">Сидячая</span></button>
          <button type="button" class="sel-btn" id="btnLight" onclick="setActivity('light')"><span class="ic" style="color:var(--accent)"><span data-ic="walk" data-sz="22"></span></span><span class="tx">Лёгкая</span><span class="sb">1–3 раза</span></button>
          <button type="button" class="sel-btn" id="btnModerate" onclick="setActivity('moderate')"><span class="ic" style="color:var(--accent)"><span data-ic="run" data-sz="22"></span></span><span class="tx">Средняя</span><span class="sb">3–5 раз</span></button>
        </div><input type="hidden" id="regActivity" value="moderate">
      </div>
      <button type="submit" class="btn btn-primary btn-block" style="font-size:16px">Создать профиль →</button>
    </form>
  </div>
</div>

<!-- ГЛАВНАЯ -->
<div class="screen" id="screen-home">
  <div class="home-head">
    <div class="avatar" id="homeAvatar"></div>
    <div style="flex:1;min-width:0">
      <div class="subtle" style="font-size:12px;font-weight:600" id="greetingTime">Привет</div>
      <div style="font-size:18px;font-weight:800" id="dashName">друг</div>
    </div>
    <button class="icon-btn pressable" onclick="navigate('profile')" aria-label="Профиль"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v4m0 14v4M4.2 4.2l2.8 2.8m10 10 2.8 2.8M1 12h4m14 0h4M4.2 19.8l2.8-2.8m10-10 2.8-2.8"/></svg></button>
  </div>
  <div id="homeTip"></div>
  <div class="hero-card">
    <div>
      <div class="hero-label">Серия тренировок</div>
      <div class="hero-num" id="streakText">0 дней</div>
    </div>
    <div class="ring">
