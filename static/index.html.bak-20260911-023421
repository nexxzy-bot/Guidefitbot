function completeSet(exIdx, setIdx){
  const btn = $('c-' + exIdx + '-' + setIdx);
  if(!btn || btn.classList.contains('done')) return;
  const ex = currentExercises[exIdx];
  btn.classList.add('done');
  const meta = currentExerciseMeta[exIdx];
  meta.doneSets++;
  $('exdone-' + exIdx).textContent = meta.doneSets + '/' + ex.sets;
  haptic('ok');
  // таймер отдыха после подхода (кроме последнего подхода последнего упражнения)
  const isLastOverall = exIdx === currentExercises.length - 1 && setIdx === ex.sets - 1;
  if(!isLastOverall && ex.rest_seconds > 0) startRest(ex.rest_seconds);
}

function startRest(seconds){
  restRemaining = seconds;
  $('restTime').textContent = restRemaining;
  $('restOverlay').classList.add('show');
  clearInterval(restTimer);
  restTimer = setInterval(() => {
    restRemaining--;
    if(restRemaining <= 0){
      clearInterval(restTimer); restTimer = null;
      $('restOverlay').classList.remove('show');
      try{ if(tg && tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('success'); }catch(e){}
      if(navigator.vibrate) navigator.vibrate([120, 60, 120]);
      showSuccess('Отдых окончен! Следующий подход 💪');
    } else $('restTime').textContent = restRemaining;
  }, 1000);
}
function skipRest(){
  clearInterval(restTimer); restTimer = null;
  $('restOverlay').classList.remove('show');
  haptic();
}

function startTimer(){
  clearInterval(workoutTimer);
  workoutTimer = setInterval(() => {
    if(timerPaused) return;
    workoutSeconds++;
    const el = $('workoutTimer');
    if(el) el.textContent = String(Math.floor(workoutSeconds/60)).padStart(2,'0') + ':' + String(workoutSeconds%60).padStart(2,'0');
  }, 1000);
}
function toggleTimer(){
  timerPaused = !timerPaused;
  $('timerBtn').textContent = timerPaused ? 'Продолжить' : 'Пауза';
}

function abortWorkout(){
  if(!confirm('Завершить без сохранения? Тренировка не запишется.')) return;
  clearInterval(workoutTimer); workoutTimer = null;
  skipRest();
  isProgramWorkout = false; currentProgramDay = null;
  navigate('workouts');
}

async function finishWorkout(isProgram){
  clearInterval(workoutTimer); workoutTimer = null;
  skipRest();
  const duration = Math.max(Math.floor(workoutSeconds / 60), 1);
  let totalVolume = 0;
  const sets = [];
  currentExercises.forEach((ex, idx) => {
    for(let i = 0; i < ex.sets; i++){
      const wEl = $('w-' + idx + '-' + i), rEl = $('r-' + idx + '-' + i);
      const w = parseFloat(wEl && wEl.value) || 0, r = parseInt(rEl && rEl.value) || 0;
      if(r > 0){ totalVolume += w * r; sets.push({ exercise_id: ex.id, set_number: i + 1, reps: r, weight: w }); }
    }
  });
  try{
    await api('/api/workout/log', {
      method:'POST',
      body: {
        tg_id: currentUser.tg_id,
        program_id: isProgram ? currentProgramId : null,
        program_day_id: isProgram ? currentProgramDay : null,
        duration_minutes: duration, total_volume: totalVolume, notes: '', sets
      }
    });
    showSuccess('Тренировка завершена! 🔥 ' + duration + ' мин');
    if(isProgram && currentProgramId){
      try{
        const p = await api('/api/user/program/progress', { method:'POST', body:{ tg_id: currentUser.tg_id } });
        if(p.completed) setTimeout(() => showSuccess('Программа завершена! 🎉'), 1200);
      }catch(e2){ /* день программы без активной программы — тренировка сохранена, это ок */ }
    }
    isProgramWorkout = false; currentProgramDay = null;
    navigate('workouts');
  }catch(e){ showError('Ошибка сохранения тренировки'); }
}

