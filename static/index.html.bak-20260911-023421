      '<button class="btn btn-ghost" style="min-height:32px;padding:4px 10px;font-size:12px;margin-top:8px;color:var(--red)" onclick="deleteMeal(' + m.log_id + ')">Удалить</button></div>'
    ).join('');
  }catch(e){ c.innerHTML = '<div class="empty">Ошибка загрузки</div>'; }
}

function macroRow(name, val, norm, fillCls){
  const pct = norm > 0 ? Math.min(val / norm * 100, 100) : 0;
  return '<div class="mb3"><div class="flex between items-center mb1"><span class="subtle" style="font-size:11px;font-weight:700">' + name + '</span><span class="subtle" style="font-size:11px;font-weight:700">' + Math.round(val) + ' / ' + norm + ' г</span></div><div class="track"><div class="fill ' + fillCls + '" style="width:' + pct + '%"></div></div></div>';
}

async function loadShoppingList(){
  const c = $('nutritionContent'); const tgId = currentUser && currentUser.tg_id;
  c.innerHTML = '<div class="flex items-center gap2 mb4"><button class="icon-btn pressable" onclick="loadNutrition()"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg></button><h3>Список покупок</h3></div><div id="shopList"></div>';
  try{
    const d = await api('/api/shopping-list/' + tgId);
    const list = $('shopList');
    if(!d.items || !d.items.length) list.innerHTML = '<div class="empty">Нет данных за неделю</div>';
    else list.innerHTML = '<div class="card">' + d.items.map(i => '<div style="padding:9px 0;border-bottom:1px solid var(--border);font-size:14px;font-weight:600">' + fmtIng(i) + '</div>').join('') + '</div>';
  }catch(e){ showError('Ошибка загрузки'); }
}

function openMealSelector(category){
  currentMealCategory = category;
  const names = { breakfast:'Завтрак', lunch:'Обед', snack:'Перекус', dinner:'Ужин' };
  $('nutritionContent').innerHTML =
    '<div class="flex items-center gap2 mb4"><button class="icon-btn pressable" onclick="loadNutrition()"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg></button><h3>' + names[category] + '</h3></div><div id="mealCardArea"></div>';
  loadNextMeal();
}

async function loadNextMeal(){
  const area = $('mealCardArea');
  area.innerHTML = '<div class="shimmer" style="height:220px"></div>';
  try{
    const exclude = currentMealRecipe ? currentMealRecipe.id : null;
    const d = await api('/api/meal', { method:'POST', body:{ category: currentMealCategory, goal: currentUser ? currentUser.goal : null, exclude_id: exclude } });
    if(!d.recipe){ area.innerHTML = '<div class="empty">Нет рецептов</div>'; return; }
    currentMealRecipe = d.recipe;
    const r = d.recipe;
    const ings = Array.isArray(r.ingredients) ? r.ingredients : [];
    area.innerHTML =
      '<div class="card mb4">' +
      '<div class="recipe-hero" id="mealHero"><span style="color:var(--accent);display:flex">' + ic('bowl',42) + '</span></div>' +
      '<h3 style="font-size:19px;margin-bottom:6px">' + esc(r.title) + '</h3>' +
      '<div class="kpi mb3">' +
      '<div class="c"><div class="v">' + Math.round(r.calories) + '</div><div class="l">Ккал</div></div>' +
      '<div class="c"><div class="v">' + Math.round(r.protein) + '</div><div class="l">Белки</div></div>' +
      '<div class="c"><div class="v">' + Math.round(r.fat) + '</div><div class="l">Жиры</div></div>' +
      '<div class="c"><div class="v">' + Math.round(r.carbs) + '</div><div class="l">Углев.</div></div></div>' +
      '<p class="subtle" style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px">Ингредиенты</p>' +
      '<p class="muted" style="font-size:13px;line-height:1.7;margin-bottom:16px">' + ings.map(fmtIng).join(' • ') + '</p>' +
      '<div class="flex gap2"><button class="btn btn-ghost" style="flex:1" onclick="loadNextMeal()">' + ic('refresh',15) + ' Другое</button>' +
      '<button class="btn btn-primary" style="flex:1" onclick="showRecipeDetail()">' + ic('chef',15) + ' Готовить</button></div></div>';
    api('/api/recipe-image/' + r.id).then(img => {
      if(img.image_url){ const el = $('mealHero'); if(el) el.innerHTML = '<img src="' + esc(img.image_url) + '" alt="">'; }
    }).catch(()=>{});
  }catch(e){ area.innerHTML = '<div class="empty">Ошибка загрузки</div>'; }
}

function showRecipeDetail(){
  if(!currentMealRecipe) return;
  const r = currentMealRecipe;
  const steps = Array.isArray(r.recipe_steps) ? r.recipe_steps : [];
  const names = { breakfast:'Завтрак', lunch:'Обед', snack:'Перекус', dinner:'Ужин' };
  $('nutritionContent').innerHTML =
    '<div class="flex items-center gap2 mb4"><button class="icon-btn pressable" onclick="openMealSelector(currentMealCategory)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg></button><h3>' + names[currentMealCategory] + ' • рецепт</h3></div>' +
    '<div class="card mb4">' +
    '<div class="recipe-hero" id="mealHero2"><span style="color:var(--accent);display:flex">' + ic('bowl',42) + '</span></div>' +
    '<h3 style="font-size:19px;margin-bottom:14px">' + esc(r.title) + '</h3>' +
    '<p class="subtle" style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px">Приготовление</p>' +
    steps.map((s, i) => '<div class="step"><span class="step-n">' + (i+1) + '</span><span class="muted" style="font-size:13px;line-height:1.6">' + esc(s) + '</span></div>').join('') +
    '<div class="flex gap2 mt4"><button class="btn btn-ghost" style="flex:1" onclick="openMealSelector(currentMealCategory)">← Назад</button>' +
    '<button class="btn btn-primary" style="flex:1" onclick="logCurrentMeal()">' + ic('pen',15) + ' Записать в дневник</button></div></div>';
  api('/api/recipe-image/' + r.id).then(img => {
    if(img.image_url){ const el = $('mealHero2'); if(el) el.innerHTML = '<img src="' + esc(img.image_url) + '" alt="">'; }
  }).catch(()=>{});
}

async function logCurrentMeal(){
  if(!currentMealRecipe) return;
  try{
    await api('/api/log-meal', { method:'POST', body:{ tg_id: currentUser.tg_id, recipe_id: currentMealRecipe.id } });
    showSuccess('«' + currentMealRecipe.title + '» записано! 🍽️');
    navigate('nutrition');
  }catch(e){ showError(e.message); }
}

async function deleteMeal(logId){
  if(!confirm('Удалить приём пищи?')) return;
  try{
    await api('/api/food-log/' + logId + '?tg_id=' + currentUser.tg_id, { method:'DELETE' });
    showSuccess('Удалено');
    loadNutrition();
  }catch(e){ showError('Не удалось удалить'); }
}

/* ============ профиль ============ */
async function loadProfile(){
  const c = $('profileContent'); const tgId = currentUser && currentUser.tg_id; if(!tgId) return;
  c.innerHTML = '<div class="shimmer"></div>';
  try{
    const [user, weight, ach] = await Promise.all([
      api('/api/user/' + tgId), api('/api/weight/' + tgId), api('/api/achievements/' + tgId)
    ]);
    currentUser = user;
    const gt = user.goal === 'lose' ? 'Похудение' : user.goal === 'gain' ? 'Набор массы' : 'Поддержание';
    c.innerHTML =
      '<div class="card mb4"><div class="flex between items-center"><div>' +
      '<h2 style="font-size:21px">' + esc(user.name) + '</h2>' +
      '<p class="muted" style="font-size:13px;margin-top:4px">' + user.age + ' ' + plural(user.age,'год','года','лет') + ' • ' + user.height + ' см • ' + user.current_weight + ' → ' + user.target_weight + ' кг</p></div>' +
      '<div class="avatar">' + esc(user.name.charAt(0).toUpperCase()) + '</div></div>' +
      '<div class="flex gap2 mt3" style="flex-wrap:wrap"><span class="badge badge-accent">' + gt + '</span><span class="badge badge-violet">' + (user.gender==='male'?'Мужчина':'Женщина') + '</span><span class="badge badge-blue">' + user.calorie_norm + ' ккал</span></div></div>' +
      '<div class="card mb4"><h3 class="mb3">Вес</h3><div id="weightChart" style="height:170px"></div>' +
      '<div class="flex gap2 mt3"><input type="number" step="0.1" class="input" id="newWeight" placeholder="Вес, кг" style="flex:1"><button class="btn btn-primary" onclick="saveWeight()">Сохранить</button></div></div>' +
      '<div class="card mb4"><h3 class="mb3">Приёмы пищи в день</h3><div class="flex gap2">' +
      [2,3,4,5,6].map(n => '<button class="chip' + (user.meal_count===n?' active':'') + '" id="mc' + n + '" onclick="setMealCount(' + n + ')">' + n + '</button>').join('') + '</div></div>' +
      '<div id="weeklyReport"></div>' +
      '<h3 class="mb3">Достижения</h3><div id="achList"></div>';

    renderWeightChart(weight.history || []);

    const unlockedCount = (ach.achievements || []).filter(a => a.unlocked).length;
    const seenKey = 'gf_ach_' + tgId;
    const seen = parseInt(localStorage.getItem(seenKey) || '0');
    if(unlockedCount > seen && seen > 0) setTimeout(() => showSuccess('Новое достижение разблокировано! 🏅'), 600);
    localStorage.setItem(seenKey, String(unlockedCount));

    $('achList').innerHTML = (ach.achievements || []).map(a =>
      '<div class="ach' + (a.unlocked ? '' : ' locked') + '"><div class="ach-ic">' + a.icon + '</div>' +
      '<div style="flex:1"><h3 style="font-size:14px">' + esc(a.title) + '</h3><p class="muted" style="font-size:11px">' + esc(a.description) + '</p></div>' +
      (a.unlocked ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>' : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text3)" stroke-width="2"><path d="M12 2v20M5 12h14"/></svg>') + '</div>'
    ).join('');

    loadWeeklyReport();
  }catch(e){}
}

function renderWeightChart(history){
  const chart = $('weightChart');
  if(history.length > 1){
    const vals = history.slice().reverse();
    const min = Math.min.apply(null, vals.map(v => v.weight)) - 2;
    const max = Math.max.apply(null, vals.map(v => v.weight)) + 2;
    const range = max - min || 1, W = 400, H = 160, pad = 24;
    const pts = vals.map((v, i) => {
      const x = pad + (i / (vals.length - 1)) * (W - pad * 2);
      const y = H - pad - ((v.weight - min) / range) * (H - pad * 2);
      return x.toFixed(1) + ',' + y.toFixed(1);
    }).join(' ');
    let grid = '';
    for(let i = 0; i <= 3; i++){ const gy = pad + (i / 3) * (H - pad * 2); grid += '<line x1="' + pad + '" y1="' + gy + '" x2="' + (W - pad) + '" y2="' + gy + '" stroke="rgba(12,34,51,.07)"/>'; }
    chart.innerHTML = '<svg viewBox="0 0 ' + W + ' ' + H + '" style="width:100%;height:100%">' + grid +
      '<polyline points="' + pts + '" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>' +
      vals.map((v, i) => {
        const x = pad + (i / (vals.length - 1)) * (W - pad * 2);
        const y = H - pad - ((v.weight - min) / range) * (H - pad * 2);
        return '<circle cx="' + x.toFixed(1) + '" cy="' + y.toFixed(1) + '" r="4.5" fill="var(--surface)" stroke="var(--accent)" stroke-width="2.5"/>';
      }).join('') + '</svg>' +
      '<div class="flex between mt2"><span class="subtle" style="font-size:10px;font-weight:700">' + esc(vals[0].date.slice(5)) + '</span><span class="subtle" style="font-size:10px;font-weight:700">' + esc(vals[vals.length-1].date.slice(5)) + '</span></div>';
  } else chart.innerHTML = '<div class="empty" style="padding:16px">Записывай вес — здесь появится график</div>';
}

async function loadWeeklyReport(){
  try{
    const r = await api('/api/weekly-report/' + currentUser.tg_id);
    $('weeklyReport').innerHTML = '<div class="card mb4"><h3 class="mb3">Неделя</h3><div class="kpi">' +
      '<div class="c"><div class="v">' + r.totalWorkouts + '</div><div class="l">Трени</div></div>' +
      '<div class="c"><div class="v">' + r.totalMinutes + '</div><div class="l">Минут</div></div>' +
      '<div class="c"><div class="v">' + r.avgCalories + '</div><div class="l">Ккал/д</div></div>' +
      '<div class="c"><div class="v">' + (r.weightChange > 0 ? '+' : '') + r.weightChange + '</div><div class="l">Кг</div></div></div></div>';
  }catch(e){}
}

async function setMealCount(n){
  try{
    await api('/api/user/update', { method:'POST', body:{ tg_id: currentUser.tg_id, meal_count: n } });
    currentUser.meal_count = n;
    showSuccess('Сохранено: ' + n + ' ' + plural(n,'приём','приёма','приёмов'));
    [2,3,4,5,6].forEach(x => { const el = $('mc'+x); if(el) el.classList.toggle('active', x===n); });
  }catch(e){ showError(e.message); }
}

async function saveWeight(){
  const w = parseFloat($('newWeight').value);
  if(!w){ showError('Введи вес'); return; }
  try{
    await api('/api/weight', { method:'POST', body:{ tg_id: currentUser.tg_id, weight: w } });
    showSuccess('Вес сохранён! ⚖️');
    loadProfile();
  }catch(e){ showError(e.message); }
}

initApp();
</script>
