function setGender(g){ $('regGender').value = g; $('btnMale').classList.toggle('active', g==='male'); $('btnFemale').classList.toggle('active', g==='female'); }
function setGoal(g){ $('regGoal').value = g; ['Lose','Gain','Maintain'].forEach(x => $('btn'+x).classList.toggle('active', x.toLowerCase()===g)); }
function setActivity(a){ $('regActivity').value = a; ['Sedentary','Light','Moderate'].forEach(x => $('btn'+x).classList.toggle('active', x.toLowerCase()===a)); }

$('registerForm').addEventListener('submit', async e => {
  e.preventDefault();
  if(!$('regGender').value || !$('regGoal').value){ showError('Выбери пол и цель'); return; }
  const data = {
