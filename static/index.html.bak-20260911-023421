function showToast(msg, type){
  const t = $('toast');
  t.textContent = msg;
  t.className = 'toast' + (type==='error'?' err':'') + (type==='success'?' ok':'');
  requestAnimationFrame(()=>t.classList.add('show'));
  clearTimeout(t._h); t._h = setTimeout(()=>t.classList.remove('show'), 3000);
}
function showError(m){ showToast(m,'error'); haptic('err'); }
function showSuccess(m){ showToast(m,'success'); haptic('ok'); }

async function api(endpoint, opts = {}){
  const headers = { 'Content-Type':'application/json' };
  if(tg && tg.initData) headers['X-Telegram-Init-Data'] = tg.initData;
  const res = await fetch(API + endpoint, { ...opts, headers, body: opts.body ? JSON.stringify(opts.body) : undefined });
  if(!res.ok){
    const err = await res.json().catch(()=>({}));
    const e = new Error(err.error || ('Ошибка ' + res.status));
    e.status = res.status;
    throw e;
  }
  return res.json();
}

/* ============ тема Telegram ============ */
function applyTelegramTheme(){
  try{
    if(!tg || !tg.themeParams) return;
    const tp = tg.themeParams, r = document.documentElement.style;
    if(tp.bg_color){ r.setProperty('--bg', tp.bg_color); r.setProperty('--bg2', tp.bg_color); document.body.style.background = tp.bg_color; }
    if(tp.text_color) r.setProperty('--text', tp.text_color);
    if(tp.hint_color) r.setProperty('--text3', tp.hint_color);
    if(tp.secondary_bg_color) r.setProperty('--solid', tp.secondary_bg_color);
    if(tp.button_color) r.setProperty('--accent', tp.button_color);
    if(tp.button_text_color) r.setProperty('--accent-text', tp.button_text_color);
  }catch(e){}
}

/* ============ навигация ============ */
const TABS = ['home','stats','workouts','nutrition','profile'];
function navigate(screen){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const t = $('screen-'+screen); if(t) t.classList.add('active');
  const b = document.querySelector('.nav-item[data-tab="'+screen+'"]'); if(b) b.classList.add('active');
  window.scrollTo(0,0);
  backTarget = null;
  if(tg && tg.BackButton){
    if(screen==='program'){ backTarget='workouts'; tg.BackButton.show(); }
    else if(screen==='active-workout'){ tg.BackButton.show(); }
    else tg.BackButton.hide();
  }
  if(screen==='home') loadDashboard();
  if(screen==='stats') loadStats();
  if(screen==='workouts') loadWorkouts();
  if(screen==='nutrition') loadNutrition();
  if(screen==='profile') loadProfile();
}
if(tg && tg.BackButton){
  tg.BackButton.onClick(()=>{
    haptic();
    if(backTarget) navigate(backTarget);
    else if($('screen-active-workout').classList.contains('active')) abortWorkout();
  });
}

/* хаптика на все кнопки */
document.addEventListener('click', e => {
  if(e.target.closest('.btn,.chip,.nav-item,.loc-card,.sel-btn,.meal-add,.icon-btn,.set-check')) haptic();
}, true);

/* свайп между вкладками + pull-to-refresh */
(function(){
  let sx=0, sy=0, st=0, pulling=false;
  document.addEventListener('touchstart', e => {
    sx = e.touches[0].clientX; sy = e.touches[0].clientY;
    st = Date.now(); pulling = window.scrollY <= 0;
  }, {passive:true});
  document.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    if(Date.now()-st > 600) return;
    const active = document.querySelector('.screen.active');
    if(!active) return;
    const id = active.id.replace('screen-','');
    if(pulling && dy > 90 && Math.abs(dx) < 40 && TABS.includes(id)){ haptic(); navigate(id); return; }
    if(TABS.includes(id) && Math.abs(dx) > 70 && Math.abs(dy) < 40){
      const i = TABS.indexOf(id);
      const next = TABS[dx < 0 ? Math.min(i+1, TABS.length-1) : Math.max(i-1, 0)];
      if(next !== id){ haptic(); navigate(next); }
    }
  }, {passive:true});
})();

/* ============ инициализация ============ */
function myTgId(){
  try{
    const q = new URLSearchParams(window.location.search).get('tg_id');
    if(q) return String(q);
    if(tg && tg.initDataUnsafe && tg.initDataUnsafe.user && tg.initDataUnsafe.user.id) return String(tg.initDataUnsafe.user.id);
  }catch(e){}
  return 'demo_user';
}

async function initApp(){
  applyTelegramTheme();
  document.querySelectorAll('[data-ic]').forEach(function(el){ el.innerHTML = ic(el.getAttribute('data-ic'), parseInt(el.getAttribute('data-sz') || '22', 10)); });
  if(tg){
    tg.ready(); tg.expand();
    try{ tg.setHeaderColor('bg_color'); tg.setBackgroundColor('bg_color'); }catch(e){}
    haptic();
  }
  if('serviceWorker' in navigator){ navigator.serviceWorker.register('/sw.js').catch(()=>{}); }
  const tgId = myTgId();
  try{
    const user = await api('/api/user/' + tgId);
    currentUser = user;
    renderAvatar(user.name);
    $('bottomNav').style.display = 'flex';
    navigate('home');
  }catch(e){
    $('screen-register').classList.add('active');
  }
}

function renderAvatar(name){
  const el = $('homeAvatar');
  const tUser = tg && tg.initDataUnsafe ? tg.initDataUnsafe.user : null;
  if(tUser && tUser.photo_url){ el.innerHTML = '<img src="' + esc(tUser.photo_url) + '" alt="">'; }
  else el.textContent = (name || 'U').charAt(0).toUpperCase();
}

