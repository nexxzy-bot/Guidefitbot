/* ============ дашборд ============ */
async function loadDashboard(){
  if(!currentUser) return;
  const tgId = currentUser.tg_id;
  try{
    const data = await api('/api/dashboard', { method:'POST', body:{ tg_id: tgId } });
    const hour = new Date().getHours();
    $('greetingTime').textContent = hour < 6 ? 'Доброй ночи' : hour < 12 ? 'Доброе утро' : hour < 18 ? 'Добрый день' : 'Добрый вечер';
    $('dashName').textContent = data.user ? data.user.name : 'друг';

    const streak = data.streak || 0;
    const C = 2 * Math.PI * 42;
    $('weekRing').style.strokeDasharray = C;
    $('weekRing').style.strokeDashoffset = C - Math.min(streak/7, 1) * C;
    $('ringText').textContent = streak + '/7';
    $('streakText').textContent = streak + ' ' + plural(streak, 'день', 'дня', 'дней');

    $('homeCals').textContent = Math.round(data.consumption ? data.consumption.calories : 0);
    $('homeWater').textContent = data.water || 0;

    renderHomeMeals(data);

    if(data.hasWorkout){
      $('dashWorkoutBadge').textContent = 'Выполнено'; $('dashWorkoutBadge').className = 'badge badge-green mb2';
      $('dashWorkoutTitle').textContent = 'Тренировка выполнена';
      $('dashWorkoutDesc').textContent = 'Отличная работа! Восстановись.';
    } else {
      $('dashWorkoutBadge').textContent = 'Тренировка'; $('dashWorkoutBadge').className = 'badge badge-amber mb2';
      $('dashWorkoutTitle').textContent = 'Начни тренировку';
      $('dashWorkoutDesc').textContent = 'Программа или свободная';
    }

    if(data.activeProgram){
      const p = data.activeProgram;
      $('dashProgramCard').classList.remove('hidden');
      $('dashProgramName').textContent = p.program_name;
      $('dashProgramProgress').textContent = 'Неделя ' + p.current_week + ', день ' + p.current_day;
      const totalDays = p.total_days || 1;
      const perWeek = Math.max(Math.round(totalDays / (p.duration_weeks || 1)), 1);
      const done = Math.min((p.current_week - 1) * perWeek + (p.current_day - 1), totalDays);
      $('dashProgramBar').style.width = Math.min(done / totalDays * 100, 100) + '%';
    } else $('dashProgramCard').classList.add('hidden');

    // тултип первого визита
    if(!localStorage.getItem('gf_tip_home')){
      $('homeTip').innerHTML = '<div class="tooltip">' + ic('sparkles',17) + ' <span><b>Привет!</b> Нажми на слот питания, чтобы подобрать блюдо под свою цель. Потяни вниз — обновится экран.</span></div>';
      localStorage.setItem('gf_tip_home', '1');
      setTimeout(()=>{ $('homeTip').innerHTML=''; }, 12000);
    }
  }catch(e){ if(e.status !== 404) showError(e.message); }
}

/* динамические слоты по meal_count */
function mealSlots(count){
