# Android: артефакты сборки и ключ подписи (не коммитить!)
android/build/
android/*.apk
android/*.idsig
android/*.keystore

# Локальный кеш фото (Pexels → webp), генерируется на сервере
static/images/cache/
# Локальные фото блюд (Unitools/Pexels → webp), генерируется scripts/preheat-images.js
static/images/dishes/
# GIF-анимации упражнений (Gym visual), скачиваются scripts/match-exercises.js
static/images/exercises/
# Метаданные exercises-dataset (17МБ, runtime для пересопоставления)
data/exercises-dataset.json

static/*.apk
android/*.apk

# стейт генератора блюд (runtime)
data/gen-state.json

# Скиллы ИИ-агентов: ставятся локально через `npx skills add`, в репозиторий не идут
# (сторонний невыверенный контент, к рантайму приложения отношения не имеет)
.agents/
skills-lock.json
