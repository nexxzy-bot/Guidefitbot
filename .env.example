# GuideFit — шаблон окружения. Скопируйте в .env и заполните.
# Никаких секретов в репозитории: .env в .gitignore.

# Порт приложения (за nginx проксируется localhost:3000)
MINIAPP_PORT=3000

# Публичный https-адрес приложения: нужен Telegram-боту для кнопки «Открыть GuideFit»
MINIAPP_URL=

# Токен бота: им подписываются initData (вход из Telegram) и отправляются напоминания
TELEGRAM_TOKEN=

# @username бота без «@» — по нему строится ссылка привязки напоминаний для ВК/анонимных аккаунтов
TELEGRAM_USERNAME=

# Админка /admin.html. Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=

# VK ID (вход в standalone/APK).
# redirect_uri: https://app.xn--80aag3axnld9b.xn--p1ai/api/auth/vk/callback
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Внешние сервисы (нужны только скриптам предзагрузки/генерации контента)
PEXELS_API_KEY=
GEMINI_API_KEY=

# Часовой пояс: дата «сегодня», SQLite localtime и часы напоминаний
TZ=Europe/Moscow

# --- Необязательное ---
# Путь к базе (по умолчанию ./guidefit.db). Используется тестами и бэкапом.
# DB_PATH=./guidefit.db
# Куда складывать резервные копии: npm run backup
# BACKUP_DIR=./backups
# Сколько дней хранить копии (0 — хранить все)
# BACKUP_KEEP_DAYS=14
# Принудительно пересобрать каталоги из JSON при старте (обычно не нужно)
# SEED_FORCE=1
