# GuideFit — шаблон окружения. Скопируйте в .env и заполните.
# Никаких секретов в репозитории: .env в .gitignore.

# Порт приложения (за nginx проксируется localhost:3000)
MINIAPP_PORT=3000

# Публичный https-адрес приложения: на него VK ID возвращает код авторизации (redirect_uri)
MINIAPP_URL=

# --- Только для доставки сборок (npm run send-build). Приложение Telegram НЕ использует ---
# Токен бота от @BotFather — им отправляется собранный APK вам в чат
TELEGRAM_TOKEN=
# Куда присылать сборку: ваш chat_id (узнать у @userinfobot). Можно оставить пустым и задать ADMIN_ID
BUILD_CHAT_ID=
# Используется как BUILD_CHAT_ID, если тот не задан (историческое имя переменной)
ADMIN_ID=

# Админка /admin.html. Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=

# Управление обновлениями Android-обёртки (RuStore): если версия на устройстве
# ниже MIN_VERSION или FORCE_UPDATE=1, приложение покажет диалог «Обновить в RuStore».
# ВАЖНО: если MIN_VERSION не задан, он равен текущей версии сервера (package.json), т.е.
# все более старые сборки получают ОБЯЗАТЕЛЬНОЕ обновление (без кнопки «Позже»).
# Чтобы обновление было добровольным, укажите MIN_VERSION ниже текущей версии.
#MIN_VERSION=2.6.0
#FORCE_UPDATE=0

# VK ID (вход в standalone/APK).
# redirect_uri: https://app.xn--80aag3axnld9b.xn--p1ai/api/auth/vk/callback
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Внешние сервисы (нужны только скриптам предзагрузки/генерации контента и фото блюд)
PEXELS_API_KEY=
GEMINI_API_KEY=

# Часовой пояс: дата «сегодня», SQLite localtime и отчёты
TZ=Europe/Moscow

# --- Необязательное ---
# Путь к базе (по умолчанию ./guidefit.db). Используется тестами и бэкапом.
# DB_PATH=./guidefit.db
# Куда складывать резервные копии: npm run backup
# BACKUP_DIR=./backups
# Сколько дней хранить копии (0 — хранить все)
# BACKUP_KEEP_DAYS=14
# Принудительно пересобрать каталоги из JSON при старте (обычно не нужно)
# SEED_FORCE=1
